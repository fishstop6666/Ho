-- ฟังก์ชันที่ 3: เสกของทุกอย่างในแมพ (Spawn All Items)
local spawnItemsBtn = createButton("🎁 เสกของทั้งหมดในแมพ", Color3.fromRGB(155, 89, 182))
local function getMapItems()
local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
if not backpack then return end
local function checkAndClone(container)
for _, obj in ipairs(container:GetDescendants()) do
if obj:IsA("Tool") then
local clonedTool = obj:Clone()
clonedTool.Parent = backpack
end
end
end
-- สแกนพื้นที่จัดเก็บไอเทมในแมพ
checkAndClone(Workspace)
checkAndClone(ReplicatedStorage)
checkAndClone(Lighting)
end
spawnItemsBtn.MouseButton1Click:Connect(getMapItems)
-- ฟังก์ชันที่ 4: หยิบของไว (Fast Pickup - ProximityPrompt)
local fastPickupBtn = createButton("⚡ หยิบของไว (Fast Pickup): OFF", Color3.fromRGB(50, 50, 70))
local fastPickupActive = false
local function applyFastPickup(prompt)
if prompt:IsA("ProximityPrompt") then
prompt.HoldDuration = 0
end
end
local function toggleFastPickup()
fastPickupActive = not fastPickupActive
if fastPickupActive then
fastPickupBtn.Text = "⚡ หยิบของไว (Fast Pickup): ON"
fastPickupBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
-- ปรับระยะเวลากดของที่มีอยู่ทั้งหมด
for _, prompt in ipairs(Workspace:GetDescendants()) do
applyFastPickup(prompt)
end
-- ปรับอัตโนมัติเมื่อมีของใหม่ถูกเสกขึ้นมา
Workspace.DescendantAdded:Connect(function(descendant)
if fastPickupActive then
applyFastPickup(descendant)
end
end)
else
fastPickupBtn.Text = "⚡ หยิบของไว (Fast Pickup): OFF"
fastPickupBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
end
end
fastPickupBtn.MouseButton1Click:Connect(toggleFastPickup)
